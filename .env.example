OPENAI_API_KEY=
GOOGLE_API_KEY=

# Agent 預設 provider：openai / google / robotics-er (Gemini Robotics-ER，走 GOOGLE_API_KEY) / mlx
ROBOT_LLM_PROVIDER=robotics-er

# robot_server 的位置與選用的 token
ROBOT_SERVER_URL=http://127.0.0.1:8765
ROBOT_SERVER_TOKEN=

# token 換算成錢（每一百萬 token 的單價；都不設就只印 token 數）。兩種擇一：
#   官方定價頁的輸入／輸出單價：ROBOT_PRICE_INPUT_PER_M=、ROBOT_PRICE_OUTPUT_PER_M=
#   自己帳單算出來的平均單價（某個月帳單 ÷ 那個月的總 token，tools/token_report.py 會列每月 token）：ROBOT_PRICE_PER_M=
ROBOT_PRICE_PER_M=
ROBOT_PRICE_CURRENCY=TWD

# 評估用的 judge
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
