OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Agent 預設 provider：openai / anthropic / google / ollama / mlx
ROBOT_LLM_PROVIDER=openai

# robot_server 的位置與選用的 token
ROBOT_SERVER_URL=http://127.0.0.1:8765
ROBOT_SERVER_TOKEN=

# 評估用的 judge
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o

# browser_use 本身的雲端/對外功能一律關掉（RobotAgentBU.py 也會自己預設關）：
# 不送 posthog 匿名遙測、不做 cloud sync、啟動時不去 PyPI 查新版。
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
BROWSER_USE_VERSION_CHECK=false
