OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Agent 預設 provider：openai / anthropic / google / robotics-er (Gemini Robotics-ER，走 GOOGLE_API_KEY) / ollama / mlx
ROBOT_LLM_PROVIDER=robotics-er

# robot_server 的位置與選用的 token
ROBOT_SERVER_URL=http://127.0.0.1:8765
ROBOT_SERVER_TOKEN=

# 評估用的 judge
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
